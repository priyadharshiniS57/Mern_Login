# Server Port
PORT=5000

# MongoDB Connection String (Local MongoDB or MongoDB Atlas URI)
# Local: mongodb://127.0.0.1:27017/mern_auth_db
# Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/mern_auth_db?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/mern_auth_db

# Secret key for JWT signing
JWT_SECRET=super_secret_jwt_key_change_in_production
